+++ b/apps/desktop/src/components/pane-shell/tree/renderer/narrow-rail-collapse.test.tsx
@@ -0,0 +1,143 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { PANE_TOGGLE_REVEAL_EVENT } from '@/components/pane-shell'
+import { registry } from '@/contrib/registry'
+import { $connection } from '@/store/session'
+import { stubResizeObserver } from '@/test/jsdom'
+
+import { group, split } from '../model'
+import { $hiddenTreePanes, $layoutTree, $narrowViewport, declareDefaultTree, shownPanesInGroup } from '../store'
+
+import { NarrowOverlays, narrowOverlayWidth } from './narrow-overlays'
+import { narrowLeavesGrid, paneChrome } from './track-model'
+
+// The report: a plugin route (the Coursebook lesson) sat in the workspace while
+// a plugin-declared 340px companion pane kept its pane. At a 460px window the
+// row spent the rail's 340px first and left the main zone its 22vw floor —
+// 120px of lesson, 24px at 200% text. `collapsible` is the pane's OPT-IN; a
+// pane that declares a horizontal width is a fixed side track whether it opted
+// in or not, and below the host's dock floor that track starves the only
+// uncloseable zone. So the host collapses side rails by rule, not by opt-in,
+// and every pane it collapses must be reachable through the narrow overlay.
+
+beforeAll(() => {
+  stubResizeObserver()
+})
+
+const disposers: (() => void)[] = []
+
+const registerPane = (id: string, title: string, data: Record<string, unknown>, body: string) => {
+  disposers.push(
+    registry.register({
+      area: 'panes',
+      data,
+      id,
+      render: () => <div data-testid={`${id}-body`}>{body}</div>,
+      title
+    })
+  )
+}
+
+/** jsdom's matchMedia always reports `matches: false`; the store's narrow
+ *  reader samples it directly, so the breakpoint has to be stubbed. */
+const stubNarrowMatchMedia = (narrow: boolean) => {
+  vi.stubGlobal(
+    'matchMedia',
+    vi.fn(() => ({ addEventListener: () => undefined, matches: narrow, media: '', removeEventListener: () => undefined }))
+  )
+}
+
+beforeEach(() => {
+  window.localStorage.clear()
+  $hiddenTreePanes.set(new Set())
+
+  // The shape under test: a plugin rail that declares a width and does NOT
+  // declare `collapsible`, beside the main workspace that holds the route.
+  registerPane('workspace', 'workspace', { placement: 'main', uncloseable: true }, 'lesson')
+  registerPane('coursebook:pane', 'coursebook', { placement: 'right', width: '340px' }, 'companion chat')
+
+  declareDefaultTree(split('row', [group(['workspace']), group(['coursebook:pane'])]))
+})
+
+afterEach(() => {
+  cleanup()
+  $narrowViewport.set(false)
+  $layoutTree.set(null)
+  $connection.set(null)
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  disposers.splice(0).forEach(dispose => dispose())
+})
+
+describe('narrowLeavesGrid', () => {
+  it('collapses a width-declaring side pane even without the collapsible opt-in', () => {
+    expect(narrowLeavesGrid(paneChrome({ area: 'panes', data: { placement: 'right', width: '340px' } } as never))).toBe(
+      true
+    )
+  })
+
+  it('keeps the main zone and floating panes in place', () => {
+    expect(
+      narrowLeavesGrid(paneChrome({ area: 'panes', data: { placement: 'main', width: '340px' } } as never))
+    ).toBe(false)
+    expect(
+      narrowLeavesGrid(paneChrome({ area: 'panes', data: { placement: 'floating', width: '340px' } } as never))
+    ).toBe(false)
+  })
+
+  it('does not mistake a height-only deck for a row track', () => {
+    expect(
+      narrowLeavesGrid(paneChrome({ area: 'panes', data: { placement: 'bottom', height: '20vh' } } as never))
+    ).toBe(false)
+  })
+
+  it('still honours the explicit collapsible opt-in', () => {
+    expect(
+      narrowLeavesGrid(paneChrome({ area: 'panes', data: { collapsible: true, placement: 'left' } } as never))
+    ).toBe(true)
+  })
+})
+
+describe('a width-declaring side pane on a narrow viewport', () => {
+  it('is no longer a shown pane of its zone, so it takes no grid width', () => {
+    stubNarrowMatchMedia(true)
+    $narrowViewport.set(true)
+
+    expect(shownPanesInGroup(group(['workspace', 'coursebook:pane']))).toEqual(['workspace'])
+  })
+
+  it('stays a shown pane when the viewport is wide', () => {
+    stubNarrowMatchMedia(false)
+
+    expect(shownPanesInGroup(group(['workspace', 'coursebook:pane']))).toEqual(['workspace', 'coursebook:pane'])
+  })
+
+  it('is reachable: the right edge strip reveals it as an overlay at its declared width', () => {
+    act(() => $narrowViewport.set(true))
+
+    const { container } = render(<NarrowOverlays />)
+
+    act(() => {
+      window.dispatchEvent(
+        new CustomEvent(PANE_TOGGLE_REVEAL_EVENT, { detail: { id: 'coursebook:pane', mode: 'open' } })
+      )
+    })
+
+    const overlay = container.querySelector<HTMLElement>('[data-narrow-overlay="coursebook:pane"]')
+    expect(overlay).toBeTruthy()
+    expect(overlay?.textContent ?? '').toContain('companion chat')
+
+    // Sized to the rail's declared width so the overlay and the docked zone
+    // can never disagree about how wide the pane is. Asserted on the pure
+    // resolver: jsdom's CSSOM drops the `min()` wrapper from style.width.
+    const contribution = registry.getArea('panes').find(p => p.id === 'coursebook:pane')!
+    expect(
+      narrowOverlayWidth(
+        { paneFor: id => registry.getArea('panes').find(p => p.id === id), paneGone: () => false, overrides: {} },
+        $layoutTree.get(),
+        contribution
+      )
+    ).toBe('340px')
+  })
+})
