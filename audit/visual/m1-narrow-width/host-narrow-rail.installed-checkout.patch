+/**
+ * Does this pane LEAVE THE GRID on a narrow viewport?
+ *
+ * `collapsible: true` has always meant yes. But a pane that declares a
+ * horizontal `width` docks as a SIDE RAIL — its zone resolves to a FIXED
+ * track, so the row spends the rail's declared px FIRST and the flex main
+ * zone absorbs only the remainder. Below the dock floor
+ * (`SIDEBAR_DOCK_MIN_WIDTH_PX`) that arithmetic is not survivable: the row
+ * hands the rail its 340px and the route/page the app is FOR collapses to the
+ * main zone's 22vw floor. A 460px window with a 340px companion pane is a
+ * 120px lesson — and 24px of it at 200% text.
+ *
+ * So the rule is the host's, not the pane's: at narrow width a fixed side rail
+ * cannot coexist with the main zone, and it leaves the grid to be revealed as
+ * an edge overlay exactly like an opting-in collapsible. A plugin cannot make
+ * this call for itself — it does not know the window width, and the width at
+ * which its own rail stops paying for itself is a property of the host's
+ * breakpoint, not of the plugin's layout.
+ *
+ * MAIN and FLOATING panes keep their place: main IS the content, and a
+ * floating pane takes no track. A pane with only a `height` (the terminal
+ * deck) is a column track — it never competes for the row.
+ */
+export function narrowLeavesGrid(chrome: PaneChrome): boolean {
+  if (chrome.collapsible) {
+    return true
+  }
+
+  if (chrome.placement === 'main' || chrome.placement === 'floating') {
+    return false
+  }
+
+  return Boolean(chrome.width)
+}
