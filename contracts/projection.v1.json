  ],
  "$defs": {
    "check_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_state",
        "audit_source",
        "declared_audit_state",
        "stimulus",
        "reference",
        "rubric",
        "locale"
      ],
      "properties": {
        "audit_state": {
          "const": "passed"
        },
        "audit_source": {
          "const": "import_automated_audit"
        },
        "declared_audit_state": {
          "type": "string",
          "description": "The manifest's own audit_state, preserved verbatim. 'failed' is not in the enum because R6 withholds such a check before any spec exists; a spec that declared it failed would contradict its own provenance.",
          "enum": ["passed", "unreviewed"]
        },
        "stimulus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt"],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        "reference": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "answers"],
              "properties": {
                "kind": {
                  "const": "exact"
                },
                "answers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 41,
                  "items": {
                    "type": "string",
                    "maxLength": 8000
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "const": "rubric_only"
                }
              }
            }
          ]
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["construct", "pass_rule", "criteria"],
          "properties": {
            "construct": {
              "$ref": "https://contracts.coursebook.hermes/vocabulary/v1#/$defs/evidence_target"
            },
            "pass_rule": {
              "const": "all"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "$ref": "#/$defs/criterion"
              }
            }
          }
        },
        "locale": {
          "type": ["string", "null"],
          "maxLength": 35
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[1-9][0-9]*$",
          "maxLength": 8
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "objective_criterion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "pack_objective_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "check_id", "check_spec_withheld"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "check_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "check_spec_withheld": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "check_spec"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "check_spec": {
              "$ref": "#/$defs/check_spec"
            }
          }
        }
      ]
    }
  }
}
