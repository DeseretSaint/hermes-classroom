{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coursebook.hermes/db/v2",
  "title": "Coursebook database schema v2",
  "description": "Authoritative record shapes for the Coursebook SQLite database, which is the single source of truth. Markdown/JSON/PDF/audio are exports or artifacts, never parallel authorities. v2 adds durable lesson runs and teaching segments, binds them to session bindings, and adds revision fencing to notebook entries and packs. See `migration_plan` for impact.",
  "x-contract-id": "cb.db",
  "x-contract-version": 2,
  "x-owner": "atlas",
  "x-implementer": "cinder",
  "x-status": "frozen",
  "schema_version": 2,
  "database": "sqlite",
  "handle": "plugins.plugin_storage.plugin_db('coursebook')",
  "migration_table": "schema_migrations",
  "pragmas": {
    "journal_mode": "WAL",
    "foreign_keys": "ON",
    "busy_timeout_ms_max": 5000,
    "synchronous": "NORMAL"
  },
  "execution_policy": {
    "connection_lifetime": "one short-lived connection per unit of work; always closed",
    "mutations": "BEGIN IMMEDIATE with an expected-revision compare-and-swap",
    "long_io": "provider calls, archive generation and artifact writes never run inside a transaction",
    "artifact_writes": "staged write -> fsync -> atomic rename -> DB commit, with orphan reconciliation",
    "migrations": "one transaction per migration; recorded in schema_migrations with a checksum"
  },
  "id_policy": "Coursebook mints random ids for courses, enrollments, lesson runs, checks, attempts and operations. Titles, paths and chat session ids are never primary keys.",
